APP_NAME="Lead Radar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lead_radar
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file is safer for workers (queue restart flag); database needs healthy MySQL first
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# VK parser microservice (Docker service name on the laravel network)
PARSER_URL=http://parser:3000
PARSER_TIMEOUT=180
# Generate with: openssl rand -hex 32. Required when APP_ENV=production;
# optional for local Docker development.
PARSER_SERVICE_TOKEN=
# Set true to require a parser token outside production as well.
PARSER_REQUIRE_TOKEN=false

# Optional: logged-in VK session for comments (many threads need auth)
# 1) Set credentials  2) docker compose exec parser node src/auth/login.js
# 3) Session saved to parser/data/vk-storage-state.json (gitignored)
VK_LOGIN=
VK_PASSWORD=
# VK_SESSION_PATH=/app/data/vk-storage-state.json
# VK_LOGIN_WAIT_MS=15000
# VK_LOGIN_2FA_WAIT_MS=0

# VK scan — legacy env fallbacks only.
# Prefer MoonShine → Scan Settings (table scan_settings, seeded defaults).
# Scheduler: every-minute tick; interval_minutes / delay / limit / window come from DB.
VK_SCAN_LIMIT=8
VK_SCAN_WITH_COMMENTS=true
VK_SCAN_GROUP_DELAY_SECONDS=50
VK_SCAN_POST_WINDOW=since_last_scan
# Auto-pause schedule after N consecutive captcha/login/block job failures
VK_CAPTCHA_PAUSE_THRESHOLD=3
VK_CAPTCHA_PAUSE_MINUTES=60
# Automatically raise next-wave group delay when recent scans are slow.
VK_ADAPTIVE_GROUP_DELAY=true

# Telegram bot (Bot API) — irazasyed/telegram-bot-sdk
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: extra chats for commands (comma-separated). Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_ENABLED=true
# Full URL or base https URL (ngrok public host). Path /api/telegram/webhook is appended if missing.
TELEGRAM_WEBHOOK_URL=
# Required when APP_ENV=production. Telegram sends it in
# X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Optional: ngrok for local webhook development
NGROK_AUTHTOKEN=
NGROK_API_URL=http://ngrok:4040
