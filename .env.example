APP_NAME="Lead Radar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# A workspace invitation is valid for this number of hours.
WORKSPACE_INVITATION_EXPIRATION_HOURS=72

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lead_radar
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file is safer for workers (queue restart flag); database needs healthy MySQL first
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Direct VK API: create a service key in the VK developer cabinet.
# It is used by GET /api/vk/health and must never be exposed to the browser.
VK_API_TOKEN=
VK_API_VERSION=5.199

# VK scan — legacy env fallbacks only.
# Prefer MoonShine → Scan Settings (table scan_settings, seeded defaults).
# Scheduler: every-minute tick; interval_minutes / delay / limit / window come from DB.
VK_SCAN_LIMIT=8
VK_SCAN_WITH_COMMENTS=true
VK_SCAN_GROUP_DELAY_SECONDS=50
VK_SCAN_POST_WINDOW=since_last_scan

# Telegram bot (Bot API) — irazasyed/telegram-bot-sdk
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional HTTP(S) or SOCKS5 proxy used only for outgoing Telegram Bot API requests.
# Example: socks5h://username:password@proxy.example:1080
TELEGRAM_PROXY_URL=
# Optional: extra chats for commands (comma-separated). Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_ENABLED=true
# Full URL or base https URL (ngrok public host). Path /api/telegram/webhook is appended if missing.
TELEGRAM_WEBHOOK_URL=
# Required to issue and renew a Let's Encrypt IP certificate in production.
LETSENCRYPT_EMAIL=
# Required when APP_ENV=production. Telegram sends it in
# X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Telegram user API (MTProto) — required to read posts from channels.
# Create these at https://my.telegram.org/apps. The first test/login asks for
# the code sent to TELEGRAM_PHONE_NUMBER and stores an encrypted session file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_PATH=storage/app/telegram.session

# Telegram channel scanner (Redis queue: telegram.scan)
TELEGRAM_SCAN_ENABLED=false
TELEGRAM_SCAN_INTERVAL_MINUTES=30
TELEGRAM_SCAN_LIMIT=20
TELEGRAM_SCAN_CHANNEL_DELAY_SECONDS=3

# Optional: ngrok for local webhook development
NGROK_AUTHTOKEN=
NGROK_API_URL=http://ngrok:4040
